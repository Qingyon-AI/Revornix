[Unit]
Description=Revornix Worker Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Developer/Revornix-new/worker
ExecStart=/home/ubuntu/Developer/Revornix-new/worker/start-worker.sh
Environment="HF_ENDPOINT=https://hf-mirror.com"
Environment="HF_HUB_ENABLE_HF_TRANSFER=1"
Environment="PATH=/home/ubuntu/Developer/Revornix-new/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin"
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


# /etc/systemd/system/revornix-worker.service.d/override.conf
[Service]
Environment="OTEL_PYTHON_LOG_LEVEL=DEBUG"
Environment="OTEL_LOG_LEVEL=DEBUG"

# /etc/systemd/system/revornix-worker.service.d/override.conf
[Service]
Environment="OTEL_PYTHON_LOG_LEVEL=DEBUG"
Environment="OTEL_LOG_LEVEL=DEBUG"
